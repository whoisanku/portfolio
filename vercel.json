{
  "images": {
    "sizes": [256, 384, 640, 828, 1280, 1920],
    "formats": ["image/avif", "image/webp"],
    "remotePatterns": [
      { "protocol": "https", "hostname": "api.grove.storage" },
      { "protocol": "https", "hostname": "cdn.bsky.app" }
    ],
    "minimumCacheTTL": 31536000
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/projects/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/favicon.svg", "destination": "/api/favicon" },
    { "source": "/favicon.ico", "destination": "/api/favicon" },
    {
      "source": "/blog/:rkey",
      "destination": "/api/blog-og?rkey=:rkey"
    },
    {
      "source": "/((?!_vercel/).*)",
      "destination": "/index.html"
    }
  ]
}
